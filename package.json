{
  "name": "sat-vocab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Offline SAT vocabulary study app built on spaced repetition and retrieval practice",
  "scripts": {
    "dev": "npm run build:data && vite",
    "validate": "node scripts/validate-data.mjs",
    "build:data": "node scripts/build-data.mjs",
    "build": "npm run build:data && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:wordnet": "node scripts/check-wordnet.mjs"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "fake-indexeddb": "^6.0.0",
    "ts-fsrs": "6.0.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.1",
    "vitest": "^2.0.5",
    "wordnet-db": "^3.1.14"
  }
}
